{
  "gitignore": true,
  // .changeset/*.md files are @changesets/cli's own generated file format
  // (YAML frontmatter + prose, deliberately no top-level heading) -- not
  // authored documentation, so this repo's Markdown rules don't apply to them.
  // docs/api-report/*.md are API Extractor's own generated report format
  // (see scripts/api-docs/generate.ts) -- "Do not edit this file" is its own
  // first line, and its fixed boilerplate opens with an H2, not an H1.
  // .github/pull_request_template.md deliberately has no top-level heading
  // either: GitHub renders it directly into the PR description body, where
  // the PR's own title already serves that role -- an H1 here would just
  // duplicate it.
  "ignores": [".changeset/**", "docs/api-report/**", ".github/pull_request_template.md"],
  // MD013 (line-length) is disabled: this repository's prose is not wrapped
  // at a fixed column width, and Prettier already owns code formatting --
  // matching common practice for prose-heavy documentation (e.g. GitHub
  // itself disables MD013 in its own .github/ Markdown).
  //
  // MD029 (ordered-list-item-prefix) is disabled: CODE_REVIEW.md's long
  // numbered procedures deliberately interleave explanatory paragraphs and
  // bulleted sub-lists between steps, which markdownlint reads as separate
  // ordered lists that each "should" restart at 1. Renumbering to satisfy
  // that would destroy the "step N of M" semantics the document depends on.
  "config": { "MD013": false, "MD029": false },
  "outputFormatters": [
    ["markdownlint-cli2-formatter-json", { "name": "reports/markdownlint.json" }],
  ],
}
