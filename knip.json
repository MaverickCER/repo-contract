{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/presets/index.ts",
    "src/helpers/index.ts",
    "bin/*.mjs",
    "scripts/*.mjs",
    "scripts/schema-types.ts",
    "repo-contract.config.ts",
    "test/unit/execution/fixtures/sigint-cleanup.ts",
    "test/unit/execution/fixtures/sigint-cleanup-queued.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "!test/unit/architecture/fixtures/**",
    "!test/unit/security-network/fixtures/**",
    "bin/**/*.mjs",
    "scripts/**/*.{mjs,ts}",
    "checks/**/*.ts"
  ],
  "ignoreDependencies": [
    "@danibram/crap4ts",
    "@secretlint/secretlint-rule-preset-recommend",
    "@types/shell-quote",
    "jscpd",
    "markdownlint-cli2",
    "markdownlint-cli2-formatter-json",
    "prettier",
    "secretlint",
    "tsx",
    // typedoc-plugin-markdown: genuinely used, but its "plugin" declaration now lives in
    // internal-package-contract's shared config/typedoc-markdown.json (this repo's own
    // typedoc.markdown.json only `extends` it -- see that file) -- knip's typedoc plugin
    // resolves the config files listed below but doesn't follow an `extends` chain into
    // another npm package, so it can no longer see the reference. Exempted here instead
    // of pointing "typedoc.config" at a node_modules path, which would be fragile across
    // package managers' differing node_modules layouts. Same pattern env-cap/data-cap use.
    "typedoc-plugin-markdown"
  ],
  "ignoreBinaries": ["run.mjs", "run.cjs", "run-presets.mjs"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "typedoc": {
    "config": ["typedoc.json", "typedoc.markdown.json"]
  },
  "vitest": {
    "config": [
      "vitest.config.ts",
      "vitest.unit.config.ts",
      "vitest.integration.config.ts",
      "vitest.property.config.ts",
      "vitest.e2e.config.ts"
    ]
  }
}
