{
  "name": "repo-contract",
  "version": "0.11.4",
  "description": "Enforce your repository's own quality bar before CI even spins up. Configure arbitrary checks, capture what happened as evidence, and let repository-owned policies determine what passes. repo-contract provides the execution and evidence layer without becoming another CI system or imposing its own definition of code quality.",
  "keywords": [
    "contract",
    "ci",
    "policy",
    "evidence",
    "quality-gate",
    "process-execution",
    "typescript",
    "tool-agnostic"
  ],
  "homepage": "https://maverickcer.github.io/repo-contract/",
  "bugs": {
    "url": "https://github.com/MaverickCER/repo-contract/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaverickCER/repo-contract.git"
  },
  "license": "MIT",
  "author": {
    "name": "MaverickCER",
    "url": "https://github.com/maverickcer"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/helpers.d.ts",
        "default": "./dist/helpers.js"
      },
      "require": {
        "types": "./dist/helpers.d.cts",
        "default": "./dist/helpers.cjs"
      }
    },
    "./package.json": "./package.json",
    "./presets": {
      "import": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      },
      "require": {
        "types": "./dist/presets.d.cts",
        "default": "./dist/presets.cjs"
      }
    },
    "./schema": "./schemas/evidence.schema.json",
    "./schema/*": "./schemas/*.schema.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repo-contract": "./bin/repo-contract.mjs"
  },
  "files": [
    "bin",
    "dist",
    "helpers",
    "presets",
    "schemas",
    "src",
    "/*.md",
    "specs/**/*.md",
    "examples/**/*.md",
    "!examples/**/node_modules/**",
    "docs/api-report/**/*.md"
  ],
  "scripts": {
    "accessibility": "npm run contract -- accessibility",
    "adr:new": "node scripts/adr-new.mjs",
    "adr-governance": "npm run contract -- adr-governance",
    "api-contract": "npm run contract -- api-contract",
    "api-docs-report": "npm run contract -- api-docs-report",
    "arethetypeswrong": "npm run contract -- arethetypeswrong",
    "benchmark": "tsx benchmarks/run-benchmarks.mjs",
    "benchmark:api-contract": "tsx node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/performance-api-contract/suite.mjs",
    "benchmark:check": "tsx benchmarks/run-benchmarks.mjs --check",
    "benchmark:checks": "tsx node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/performance-checks/suite.mjs",
    "benchmark:exceptions": "tsx node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/performance-exceptions/suite.mjs",
    "benchmark:policy-evidence": "tsx node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/performance-policy-evidence/suite.mjs",
    "build": "npm run clean && tsup && tsc -p tsconfig.build.json && node scripts/emit-dts-shims.mjs",
    "check": "node scripts/check.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "precontract": "npm run build",
    "contract": "tsx scripts/run-contract.mjs",
    "contract:baseline": "internal-package-contract update-baseline",
    "coverage": "npm run contract -- coverage",
    "crap": "npm run contract -- crap",
    "dead-code": "npm run contract -- dead-code",
    "dev": "tsup --watch",
    "docs": "npm run contract -- docs",
    "docs:api": "typedoc",
    "docs:api:report": "typedoc --options typedoc.markdown.json",
    "docs:benchmarks": "node node_modules/internal-package-contract/scripts/benchmark/render-page.mjs --out docs/benchmarks/index.html --readme https://github.com/maverickcer/repo-contract/blob/main/benchmarks/README.md --history \"Checks|benchmarks/history/checks.json\" --history \"Policy & evidence|benchmarks/history/policy-evidence.json\" --history \"API contract|benchmarks/history/api-contract.json\" --history \"Exception helpers|benchmarks/history/exceptions.json\"",
    "docs:env": "internal-package-contract env",
    "duplication": "npm run contract -- duplication",
    "format": "npm run contract -- format",
    "format:check": "prettier --check .",
    "license": "npm run contract -- license",
    "lint": "npm run contract -- lint",
    "mutation": "npm run contract -- mutation",
    "precommit": "npm run contract -- format lint typecheck schema dead-code architecture adr-governance suppression-governance security-network duplication ambient-capabilities",
    "prepublishOnly": "npm run docs:api && npm run docs:benchmarks && npm run contract 1>&2",
    "prepush": "npm run contract",
    "publint": "npm run contract -- publint",
    "release": "changeset publish",
    "sbom": "npm run contract -- sbom",
    "schema": "npm run contract -- schema",
    "security:deps": "npm run contract -- security-deps",
    "security:network": "npm run contract -- security-network",
    "security:secrets": "npm run contract -- security-secrets",
    "setup": "npm run build && node scripts/install-hooks.mjs",
    "size": "npm run contract -- size",
    "smoke": "node scripts/smoke-consumer.mjs artifacts",
    "stage": "npm run contract",
    "suppression-governance": "npm run contract -- suppression-governance",
    "test": "npm run contract -- test-unit test-integration test-property test-e2e",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:coverage": "npm run contract -- test-unit test-integration test-property coverage",
    "test:e2e": "node scripts/run-test-category.mjs e2e",
    "test:integration": "node scripts/run-test-category.mjs integration",
    "test:property": "node scripts/run-test-category.mjs property",
    "test:unit": "node scripts/run-test-category.mjs unit",
    "test:watch": "vitest --watch",
    "typecheck": "npm run contract -- typecheck",
    "verify": "npm run docs:api && npm run docs:benchmarks && npm run contract",
    "version": "changeset version && npm run build && npm run sbom && internal-package-contract skill && internal-package-contract site"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "esbuild": "^0.28.1",
    "handlebars": "^4.7.10",
    "katex": "^0.18.2",
    "pa11y": {
      "puppeteer": "npm:puppeteer-core@^25.9.0"
    },
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@danibram/crap4ts": "^0.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor-model": "^7.33.13",
    "@rnx-kit/eslint-plugin": "^0.9.9",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@socketsecurity/cli": "^1.1.169",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "cross-spawn": "^7.0.6",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-node-dependencies": "^2.2.0",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-secure-coding": "^5.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-toplevel": "^1.2.0",
    "fast-check": "^4.9.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.9.0",
    "internal-package-contract": "github:MaverickCER/internal-package-contract#v0.13.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.3",
    "licensee": "^12.0.2",
    "linkinator": "^8.0.4",
    "markdownlint-cli2": "^0.24.0",
    "markdownlint-cli2-formatter-json": "^0.0.10",
    "oxlint": "^1.79.0",
    "pa11y": "^10.0.0",
    "prettier": "3.9.10",
    "publint": "^0.3.24",
    "secretlint": "^13.0.5",
    "shell-quote": "^1.8.1",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.5",
    "yaml": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "internal-package-contract": {
    "copies": [
      "benchmark-budgets",
      "reading-benchmarks",
      "typedoc-markdown",
      "writing-benchmarks"
    ],
    "checks": [
      "AgentSkill",
      "AmbientCapabilities"
    ],
    "ambientCapabilities": {
      "forbiddenDependencies": [
        "cross-spawn"
      ]
    }
  }
}
