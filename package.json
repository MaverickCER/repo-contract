{
  "name": "repo-contract",
  "version": "0.1.0",
  "description": "Enforce your repository's own quality bar before CI even spins up. Configure arbitrary checks, capture what happened as evidence, and let repository-owned policies determine what passes. repo-contract provides the execution and evidence layer without becoming another CI system or imposing its own definition of code quality.",
  "keywords": [
    "contract",
    "ci",
    "policy",
    "evidence",
    "quality-gate",
    "process-execution",
    "typescript",
    "tool-agnostic"
  ],
  "homepage": "https://github.com/maverickcer/repo-contract#readme",
  "bugs": {
    "url": "https://github.com/maverickcer/repo-contract/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maverickcer/repo-contract.git"
  },
  "license": "MIT",
  "author": {
    "name": "MaverickCER",
    "url": "https://github.com/maverickcer"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./presets": {
      "import": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      },
      "require": {
        "types": "./dist/presets.d.cts",
        "default": "./dist/presets.cjs"
      }
    },
    "./schema": "./schemas/evidence.schema.json",
    "./schema/*": "./schemas/*.schema.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "presets",
    "schemas",
    "src"
  ],
  "scripts": {
    "accessibility": "npm run contract -- accessibility",
    "adr:new": "node scripts/adr-new.mjs",
    "adr-governance": "npm run contract -- adr-governance",
    "api-contract": "npm run contract -- api-contract",
    "api-docs": "npm run contract -- api-docs",
    "api-docs:generate": "npm run build && tsx scripts/api-docs/generate.ts",
    "arethetypeswrong": "npm run contract -- arethetypeswrong",
    "build": "npm run clean && tsup && tsc -p tsconfig.build.json && node scripts/emit-dts-shims.mjs",
    "check": "node scripts/check.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "precontract": "npm run build",
    "contract": "tsx scripts/run-contract.mjs",
    "contract:baseline": "tsx scripts/api-contract/update-baseline.ts",
    "coverage": "npm run contract -- coverage",
    "crap": "npm run contract -- crap",
    "dead-code": "npm run contract -- dead-code",
    "dev": "tsup --watch",
    "docs": "npm run contract -- docs",
    "duplication": "npm run contract -- duplication",
    "format": "npm run contract -- format",
    "format:check": "prettier --check .",
    "license": "npm run contract -- license",
    "lint": "npm run contract -- lint",
    "mutation": "npm run contract -- mutation",
    "precommit": "npm run contract -- format lint typecheck schema dead-code architecture adr-governance suppression-governance security-network duplication",
    "prepare": "npm run build && node scripts/install-hooks.mjs",
    "prepublishOnly": "npm run contract",
    "prepush": "npm run contract",
    "publint": "npm run contract -- publint",
    "schema": "npm run contract -- schema",
    "security:deps": "npm run contract -- security-deps",
    "security:network": "npm run contract -- security-network",
    "security:secrets": "npm run contract -- security-secrets",
    "size": "npm run contract -- size",
    "smoke": "node scripts/smoke-consumer.mjs artifacts",
    "stage": "npm run contract",
    "suppression-governance": "npm run contract -- suppression-governance",
    "test": "npm run contract -- test-unit test-integration test-property test-e2e",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:coverage": "npm run contract -- test-unit test-integration test-property coverage",
    "test:e2e": "node scripts/run-test-category.mjs e2e",
    "test:integration": "node scripts/run-test-category.mjs integration",
    "test:property": "node scripts/run-test-category.mjs property",
    "test:unit": "node scripts/run-test-category.mjs unit",
    "test:watch": "vitest --watch",
    "typecheck": "npm run contract -- typecheck",
    "verify": "npm run contract"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "qs": "^6.15.2"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@danibram/crap4ts": "^0.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.13",
    "@microsoft/api-extractor-model": "^7.33.11",
    "@microsoft/tsdoc": "^0.16.0",
    "@rnx-kit/eslint-plugin": "^0.9.9",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-node-dependencies": "^2.2.0",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-secure-coding": "^5.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-toplevel": "^1.2.0",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.3",
    "licensee": "^11.1.1",
    "linkinator": "^8.0.4",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-cli2-formatter-json": "^0.0.9",
    "minimatch": "^10.2.6",
    "oxlint": "^1.79.0",
    "pa11y": "^9.1.1",
    "prettier": "3.9.6",
    "publint": "^0.3.24",
    "secretlint": "^9.0.0",
    "shell-quote": "^1.8.1",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11",
    "yaml": "^2.0.0"
  },
  "peerDependencies": {
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
