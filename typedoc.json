{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["internal-package-contract/config/typedoc"],
  "entryPoints": [
    "src/index.ts",
    "src/presets/index.ts",
    "src/helpers/index.ts",
    "src/affected/index.ts",
    "src/metrics/index.ts",
    "src/tiers/index.ts",
    "src/tool-config/index.ts",
    "src/tool-config/tsup.ts",
    "src/tool-config/typedoc.ts",
    "src/tool-config/knip.ts",
    "src/tool-config/vitest.ts",
    "src/tool-config/stryker.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "treatValidationWarningsAsErrors": true,
  "requiredToBeDocumented": [],
  "intentionallyNotExported": [],
  "externalSymbolLinkMappings": {
    "repo-contract": {
      "BrokenLinksOptions": "#",
      "CommitlintOptions": "#",
      "DeadCodeOptions": "#",
      "DuplicationOptions": "#",
      "LintOptions": "#",
      "MarkdownlintOptions": "#",
      "StylelintOptions": "#"
    }
  }
}
