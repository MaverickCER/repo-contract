{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["internal-package-contract/config/typedoc"],
  "entryPoints": ["src/index.ts", "src/presets/index.ts", "src/helpers/index.ts"],
  "out": "docs/api",
  "readme": "none",
  "treatValidationWarningsAsErrors": true,
  "requiredToBeDocumented": [],
  "intentionallyNotExported": [],
  "externalSymbolLinkMappings": {
    "repo-contract": {
      "BrokenLinksOptions": "#",
      "CommitlintOptions": "#",
      "DeadCodeOptions": "#",
      "DuplicationOptions": "#",
      "LintOptions": "#",
      "MarkdownlintOptions": "#",
      "StylelintOptions": "#"
    }
  }
}
