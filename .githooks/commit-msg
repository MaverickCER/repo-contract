#!/bin/sh
# repo-contract commit-message gate -- runs commitlint against the message being
# committed (Conventional Commits, per commitlint.config.mjs). The full commit
# range is re-checked by the `commitlint` self-hosting check on pre-push and in
# CI. Fix what it reports instead of skipping it.
# See CONTRIBUTING.md and specs/decisions/0009-conventional-commits-versioning-and-local-gates.md.
set -eu
npx --no-install commitlint --edit "$1"
