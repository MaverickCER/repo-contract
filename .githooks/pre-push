#!/bin/sh
# repo-contract full pre-push gate -- the same self-assurance suite CI runs
# (`npm run contract`, ~5-6 min). Bypass a draft / work-in-progress push with
# `git push --no-verify`; CI still enforces the full suite on the PR.
# See CONTRIBUTING.md and specs/decisions/0009-conventional-commits-versioning-and-local-gates.md.
#
# `npm run contract` now includes the `coderabbitai` check (see
# specs/decisions/0014-coderabbit-as-a-surfaced-check.md), which runs the same local
# `coderabbit review --agent` pass this hook used to invoke as its own separate step --
# superseded, not duplicated: `coderabbitai`'s own policy self-skips to a `warn` (never a silent
# pass) when the CLI isn't installed, exactly like this hook's own former guard did.
set -eu
npm run contract
